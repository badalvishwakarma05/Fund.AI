# ═══════════════════════════════════════════════
# FundMate AI — Environment Configuration
# Copy this to .env.local and fill in values
# ═══════════════════════════════════════════════

# ─── LLM Provider ───
# Model name for Claude API calls (e.g., claude-sonnet-4-20250514)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# ─── Database ───
# SQLite database path (relative to project root)
DATABASE_URL=./data/fundmate.db

# ─── RAG Configuration ───
# Minimum similarity score (0-1) for vector search results
RAG_MIN_SCORE=0.65
# Maximum chunks to retrieve per query
RAG_TOP_K=8

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" to enable demo mode (pre-computed results, no API key needed)
NEXT_PUBLIC_DEMO_MODE=true
